PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smma_saas

# Redis Configuration (ioredis)
REDIS_URL=redis://localhost:6379

# Vector DB (Qdrant OSS)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Inference (Groq API - Qwen 2.5)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Meta / WhatsApp Webhook Security
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_meta_verify_token_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# Telegram Mobile Control Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# Operational Flags
ENFORCE_SUBSCRIPTION_QUOTAS=false
COMMERCIAL_SAAS_MODE=false

