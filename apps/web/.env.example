# Frontend environment variables
# Copy to .env.local for local runtime overrides (git-ignored).
# Only NEXT_PUBLIC_-prefixed values are inlined into the browser bundle.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_APP_ENV=development

# Endpoint used by the Axios transport to silently renew an expired access
# token (single-flight). Must match the backend route.
NEXT_PUBLIC_API_REFRESH_PATH=/auth/refresh
NEXT_PUBLIC_APP_NAME=Styre-Bot
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
