# ==========================================
# STYRE-BOT CONFIGURATION TEMPLATE (.env.example)
# ==========================================

# 1. Application & Environment
ENV=development
PORT=8000
JWT_SECRET=your_jwt_secret_key_here

# 2. Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/styre_db

# 3. Redis (Pub/Sub & Background Workers)
REDIS_URL=redis://localhost:6379/0

# 4. LLM Engine (Groq Cloud API or Local Ollama)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

# 5. Storage Driver (local | r2 | s3)
STORAGE_DRIVER=local
S3_ENDPOINT_URL=
S3_BUCKET_NAME=styre-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_PREFIX=
S3_REGION=auto

# 6. Email Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Styre Bot <your_email@gmail.com>

# 7. Payment Gateway (Stripe - Set false to bypass)
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?status=cancelled

# 8. Webhook & Security Integrations (Optional)
RAG_CONFIDENCE_THRESHOLD=0.2
